  "properties": [
    {
      "property": "Typical composition",
      "value": "around 80% copper, 20% tin",
      "source": "cccbr-bell-founding"
    },
    {
      "property": "Why tin matters",
      "value": "alloying soft copper and tin gives a harder, more rigid and more elastic metal; the hardest bronze has a lot of tin, but too much makes the bell brittle and liable to crack",
      "source": "cccbr-bell-founding"
    },
    {
      "property": "Casting (melt) temperature",
      "value": "approximately 1,100 °C (2,010 °F)",
      "source": "cccbr-bell-founding"
    },
    {
      "property": "Surface",
      "value": "verdigris forms a protective patina against further oxidation",
      "source": "cccbr-bell-founding"
    },
    {
      "property": "Example: Liberty Bell (1753)",
      "value": "about 70% copper, 25% tin; small amounts of lead, zinc, arsenic, gold and silver",
      "source": "nps-liberty-bell-sheet"
    },
    {
      "property": "Example: Liberty Bell, fact-sheet wording",
      "value": "mostly copper and tin, with some zinc and minute traces of antimony and silver",
