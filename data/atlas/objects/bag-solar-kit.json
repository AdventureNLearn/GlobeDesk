  "safety": [
    {
      "id": "s-fuse",
      "topic": "fusing",
      "rule": "Put the main fuse on battery + as close to the cell stack as practical. Fuse at least 1.25x the continuous load and no higher than the wire can carry.",
      "citations": []
    },
    {
      "id": "s-bms",
      "topic": "bms",
      "rule": "Every series group goes through the BMS. No bypass. Use a BMS that blocks charging below 0 C.",
      "citations": [
        "cell-sheet-dtp"
      ]
    },
    {
      "id": "s-charge",
      "topic": "charging",
      "rule": "Set the MPPT max current at or below the cells' standard charge current (S kit: 6 A).",
      "citations": [
        "cell-sheet-blivex"
      ]
    },
    {
      "id": "s-thermal",
      "topic": "thermal",
      "rule": "LiFePO4 is chosen for thermal margin, but any lithium pack can run away. Keep it out of hot cars and direct sun; the panel goes in sun, the pack in shade.",
      "citations": [
        "bu-205",
        "faa-packsafe"
      ]
    },
    {
      "id": "s-air",
      "topic": "transport",
      "rule": "Spare lithium batteries go in carry-on only, terminals protected. 100 Wh or less is fine; 101-160 Wh needs airline approval, max two; the L kit is above that.",
      "citations": [
        "faa-packsafe"
      ]
    },
    {
      "id": "s-assembly",
      "topic": "assembly",
      "rule": "Weld or clamp cell joints; do not solder directly to cells. Insulate every bare metal edge. Build with the switch off and the fuse out.",
      "citations": []
    }
