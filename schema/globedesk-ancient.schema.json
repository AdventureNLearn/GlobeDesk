{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/globedesk-ancient.schema.json",
  "title": "GlobeDesk Ancient World record (globedesk.ancient/1)",
  "description": "One ancient site (kind site, with an approximate pin) or one myth or legend (kind myth, no pin, claims labelled supported or not-proven). Generated by tools/atlas/build-ancient.mjs. Every timeline row, fact and claim names a source id; gaps are [UNKNOWN]. Dates are astronomical years (1 BCE = 0).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "kind", "place", "era", "status", "tiers", "timeline", "facts", "claims", "sources", "official_sources", "official_status", "unknowns", "confidence", "checked", "license", "subject_person_living"],
  "properties": {
    "schema": { "const": "globedesk.ancient/1" },
    "id": { "$ref": "#/$defs/slug" },
    "title": { "$ref": "#/$defs/short" },
    "kind": { "enum": ["site", "myth"] },
    "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "place": {
      "if": { "type": "object" },
      "then": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "pin", "approximate", "basis", "coords_source", "pleiades", "wikidata"],
        "properties": {
          "label": { "$ref": "#/$defs/short" }, "pin": { "enum": ["shown", "held"] }, "lat": { "type": "number" }, "lng": { "type": "number" },
          "hold_reason": { "$ref": "#/$defs/short" }, "hold_source": { "$ref": "#/$defs/slug" },
          "approximate": { "const": true }, "basis": { "$ref": "#/$defs/short" }, "coords_source": { "$ref": "#/$defs/text" },
          "pleiades": { "if": { "type": "string" }, "then": { "type": "string", "pattern": "^https://pleiades\\.stoa\\.org/places/[0-9]+$" }, "else": { "const": null } },
          "wikidata": { "type": "string", "pattern": "^https://www\\.wikidata\\.org/wiki/Q[0-9]+$" }
        },
        "if": { "properties": { "pin": { "const": "held" } }, "required": ["pin"] },
        "then": { "required": ["hold_reason", "hold_source"], "allOf": [{ "not": { "required": ["lat"] } }, { "not": { "required": ["lng"] } }] },
        "else": { "required": ["lat", "lng"], "allOf": [{ "not": { "required": ["hold_reason"] } }] }
      },
      "else": { "const": null }
    },
    "era": { "type": "string", "pattern": "^([a-z0-9-]+|\\[UNKNOWN\\])$" },
    "earliest_cited_year": { "type": "integer" },
    "status": { "$ref": "#/$defs/short" },
    "status_note": { "$ref": "#/$defs/text" },
    "sensitive": { "const": true },
    "tiers": { "type": "object", "additionalProperties": false, "required": ["everyday", "student"], "properties": { "everyday": { "$ref": "#/$defs/text" }, "student": { "$ref": "#/$defs/text" } } },
    "timeline": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "facts": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "value", "source"], "properties": { "label": { "$ref": "#/$defs/short" }, "value": { "$ref": "#/$defs/text" }, "source": { "$ref": "#/$defs/slug" } } } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" } },
    "official_sources": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
    "official_status": { "enum": ["listed", "[UNKNOWN]"] },
    "unknowns": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "confidence": { "enum": ["high", "medium", "low", "[UNKNOWN]"] },
    "checked": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "license": { "$ref": "#/$defs/text" },
    "subject_person_living": { "const": false }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "short": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "row": {
      "type": "object", "additionalProperties": false, "required": ["date", "precision", "approximate", "event", "source"],
      "properties": {
        "date": { "type": "string", "pattern": "^-?[0-9]{1,4}(-[0-9]{2}){0,2}$" }, "end": { "type": "string", "pattern": "^-?[0-9]{1,4}(-[0-9]{2}){0,2}$" },
        "precision": { "enum": ["year", "month", "day"] }, "approximate": { "type": "boolean" },
        "event": { "$ref": "#/$defs/text" }, "source": { "$ref": "#/$defs/slug" }
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false, "required": ["text", "claimStatus", "sourceIds"],
      "properties": {
        "text": { "$ref": "#/$defs/text" }, "claimStatus": { "enum": ["supported", "not-proven", "disputed", "people-disagree"] },
        "sourceIds": { "type": "array", "items": { "$ref": "#/$defs/slug" } }, "note": { "$ref": "#/$defs/short" },
        "disagree": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["sourceIds", "position"], "properties": { "sourceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" } }, "position": { "$ref": "#/$defs/text" } } } }
      },
      "if": { "properties": { "claimStatus": { "const": "people-disagree" } }, "required": ["claimStatus"] },
      "then": { "required": ["disagree"] },
      "else": { "not": { "required": ["disagree"] } }
    }
  }
}
