{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/globedesk-contributor-card.schema.json",
  "title": "GlobeDesk contributor card (globedesk.contributor-card/1) - DRAFT",
  "description": "A credit card for a contributor: a public handle, a one- or two-line description, the Atlas categories they care about, up to three public https links and a checked date. No email, phone, real name, address or location fields are allowed. A card is a credit, not an Atlas entry about a person.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "handle", "description", "topics", "links", "checked", "license"],
  "properties": {
    "schema": { "const": "globedesk.contributor-card/1" },
    "handle": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,31}$", "description": "Self-chosen public handle." },
    "description": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\n]*(\\n[^\\n]*)?$", "description": "One or two lines." },
    "topics": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)?$" }, "description": "Atlas category ids, or category/subcategory." },
    "links": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/link" } },
    "checked": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "license": { "type": "string", "pattern": "^CC BY 4\\.0" }
  },
  "$defs": {
    "link": {
      "type": "object", "additionalProperties": false, "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": "string", "pattern": "^https://[^\\s\"'<>@]+$" }
      }
    }
  }
}
