{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/globedesk-prices.schema.json",
  "title": "GlobeDesk Atlas region price snapshot (globedesk.prices/1) - DRAFT",
  "description": "One file per coarse region (ISO 3166-1 country, optional ISO 3166-2 subdivision). Each row is one cited, dated price check for a part class. No store addresses, no user data. A price nobody checked is status unknown and shows as [UNKNOWN].",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "region", "currency", "rows"],
  "properties": {
    "schema": { "const": "globedesk.prices/1" },
    "region": { "type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "tax_note": { "type": "string", "maxLength": 500 },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } }
  },
  "$defs": {
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["object", "part", "status"],
      "properties": {
        "object": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "part": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "status": { "enum": ["checked", "unknown"] },
        "item": { "type": "string", "maxLength": 300 },
        "seller": { "type": "string", "maxLength": 120 },
        "url": { "type": "string", "pattern": "^https://" },
        "low": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["each", "pack", "metre", "set"] },
        "includes_tax": { "enum": ["yes", "no", "[UNKNOWN]"] },
        "checked": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "method": { "enum": ["web-search", "web-fetch", "contributor", "open-data"] },
        "note": { "type": "string", "maxLength": 500 }
      },
      "if": { "properties": { "status": { "const": "checked" } } },
      "then": { "required": ["item", "seller", "url", "low", "unit", "checked", "method"] }
    }
  }
}
