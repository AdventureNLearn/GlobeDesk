{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/globedesk-records.schema.json",
  "title": "GlobeDesk records catalog (globedesk.records/1)",
  "description": "Sidecar for cited lists and off-map rows used to build event layers. Not part of globedesk.episode/2. No online geocoder. No invented coordinates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalogs"],
  "properties": {
    "schema": { "const": "globedesk.records/1" },
    "generated": { "type": "string", "maxLength": 500 },
    "note": { "type": "string", "maxLength": 8000 },
    "catalogs": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/catalog" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "records"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[A-Za-z][A-Za-z0-9-]{0,39}$" },
        "credit": { "type": "string", "maxLength": 8000 },
        "license": { "type": "string", "maxLength": 8000 },
        "terms": { "type": "string", "maxLength": 8000 },
        "storyId": { "$ref": "#/$defs/id" },
        "layerId": { "$ref": "#/$defs/id" },
        "note": { "type": "string", "maxLength": 8000 },
        "records": {
          "type": "array",
          "maxItems": 400,
          "items": { "$ref": "#/$defs/record" }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "place", "date", "citations", "confidence", "reconstruction"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[A-Za-z][A-Za-z0-9-]{0,39}$" },
        "place": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "precision": { "type": "string", "maxLength": 500 },
        "precisionLabel": { "type": "string", "maxLength": 8000 },
        "date": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "dateEnd": { "type": "string", "maxLength": 500 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/citation" }
        },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "reconstruction": { "type": "boolean" },
        "claimStatus": { "type": "string", "enum": ["supported", "not-proven", "disputed", "people-disagree"] },
        "license": { "type": "string", "maxLength": 8000 },
        "credit": { "type": "string", "maxLength": 8000 },
        "pathId": { "$ref": "#/$defs/id" },
        "storyId": { "$ref": "#/$defs/id" },
        "note": { "type": "string", "maxLength": 8000 }
      },
      "dependentRequired": {
        "lat": ["lon"],
        "lon": ["lat"]
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S",
          "not": { "pattern": "^\\s*(\\[UNKNOWN\\]\\s*)+$" }
        },
        "url": { "type": "string", "minLength": 8, "maxLength": 2000, "pattern": "^https://\\S+$" },
        "note": { "type": "string", "maxLength": 8000 }
      }
    }
  }
}
