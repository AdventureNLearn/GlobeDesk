{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/globedesk-wonders-overview.schema.json",
  "title": "GlobeDesk wonders overview (wonders layer)",
  "description": "The wonders layer's overview: the seven winners of the unofficial 2007 popular vote (a card each, or a deferred cross-link to the Ancient layer for Petra), cited facts, claims labelled myth or not-proven, and short cited stories. Generated by tools/atlas/build-wonders.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "vote_label",
    "checked",
    "license",
    "tiers",
    "vote_date",
    "vote",
    "members",
    "counts",
    "facts",
    "claims",
    "stories",
    "sources",
    "unknowns",
    "excluded"
  ],
  "properties": {
    "schema": {
      "const": "globedesk.wonders-overview/1"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "$ref": "#/$defs/short"
    },
    "vote_label": {
      "type": "string",
      "pattern": "^Unofficial:"
    },
    "checked": {
      "$ref": "#/$defs/date"
    },
    "license": {
      "$ref": "#/$defs/short"
    },
    "tiers": {
      "$ref": "#/$defs/tiers"
    },
    "vote_date": {
      "$ref": "#/$defs/date"
    },
    "vote": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "country",
          "entry",
          "deferred_link",
          "source"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/short"
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "entry": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "deferred_link": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "source": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "linked",
          "pinned"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "linked": {
            "type": "boolean"
          },
          "pinned": {
            "type": "boolean"
          }
        }
      }
    },
    "counts": {
      "type": "object"
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourced"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "stories": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "steps"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "$ref": "#/$defs/short"
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entry",
                "text",
                "sources"
              ],
              "properties": {
                "entry": {
                  "$ref": "#/$defs/slug"
                },
                "text": {
                  "$ref": "#/$defs/short"
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/slug"
                  }
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/short"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/short"
          },
          "reason": {
            "$ref": "#/$defs/short"
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "short": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "date": {
      "type": "string",
      "pattern": "^-?[0-9]{1,4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "sourced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/short"
        },
        "source": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "everyday",
        "student"
      ],
      "properties": {
        "everyday": {
          "$ref": "#/$defs/text"
        },
        "student": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "status",
        "sources"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/short"
        },
        "status": {
          "enum": [
            "supported",
            "not-proven",
            "people-disagree",
            "myth"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/sourced"
          }
        }
      }
    }
  }
}
