{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/globedesk-work-desks.schema.json",
  "title": "GlobeDesk work desks (globedesk.work-desks/1) - DRAFT",
  "description": "The desk lineup. Experimental reference links go only to public repositories (https://github.com/AdventureNLearn/...) or public Learning Lab cards. Withheld or private projects carry no URL.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "checked",
    "license",
    "desks"
  ],
  "properties": {
    "schema": {
      "const": "globedesk.work-desks/1"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed"
      ]
    },
    "checked": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "license": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "tiers": {
      "type": "array",
      "items": {
        "enum": [
          "kids",
          "everyday",
          "student",
          "professional"
        ]
      }
    },
    "desks": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/desk"
      }
    }
  },
  "$defs": {
    "desk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "id",
        "title",
        "scope",
        "tier_note",
        "tiers",
        "news_sections",
        "atlas_categories",
        "backing",
        "official_sources",
        "official_status"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "existing": {
          "type": "boolean"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "tier_note": {
          "type": "string",
          "minLength": 1
        },
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kids",
            "everyday",
            "student",
            "professional"
          ],
          "properties": {
            "kids": {
              "type": "string"
            },
            "everyday": {
              "type": "string"
            },
            "student": {
              "type": "string"
            },
            "professional": {
              "type": "string"
            }
          }
        },
        "news_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "atlas_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "official": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "publisher",
            "url",
            "class",
            "checked"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "publisher": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://[^\\s\"'<>]+$"
            },
            "class": {
              "const": "official"
            },
            "checked": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "backing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/backing"
          }
        },
        "official_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/official"
          },
          "description": "Primary or public records only. Never an owner repo or Learning Lab card."
        },
        "official_status": {
          "enum": [
            "listed",
            "[UNKNOWN]"
          ]
        },
        "official_note": {
          "type": "string"
        }
      }
    },
    "official": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "publisher",
        "url",
        "class",
        "checked"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s\"'<>]+$"
        },
        "class": {
          "const": "official"
        },
        "checked": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "backing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "class",
        "label",
        "depth"
      ],
      "properties": {
        "class": {
          "enum": [
            "experimental",
            "internal"
          ],
          "description": "Owner repos, Learning Lab cards and withheld projects are experimental references; Atlas entries and news sections are internal GlobeDesk content. Neither is an official source."
        },
        "kind": {
          "enum": [
            "repo",
            "lab-card",
            "atlas",
            "news-section",
            "news-episode",
            "owner-project-pending"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://(github\\.com/AdventureNLearn/[A-Za-z0-9._-]+|learninglab\\.grok\\.me/)$"
        },
        "card": {
          "type": "integer",
          "minimum": 1
        },
        "entry": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^newsdesk/episodes/[a-z0-9-]+\\.globedesk\\.json$"
        },
        "depth": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
