{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/globedesk-space-overview.schema.json",
  "title": "GlobeDesk space overview (space layer)",
  "description": "The space layer's overview: member sites (new records plus existing Atlas events cross-linked, never copied), extra cited facts for the linked events, and short cited stories whose steps open Atlas entries. Generated by tools/atlas/build-space.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "checked",
    "license",
    "tiers",
    "bodies",
    "members",
    "counts",
    "linked",
    "stories",
    "sources",
    "excluded"
  ],
  "properties": {
    "schema": {
      "const": "globedesk.space-overview/1"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "$ref": "#/$defs/short"
    },
    "checked": {
      "$ref": "#/$defs/date"
    },
    "license": {
      "$ref": "#/$defs/short"
    },
    "tiers": {
      "$ref": "#/$defs/tiers"
    },
    "bodies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "enum": [
              "earth",
              "moon"
            ]
          },
          "label": {
            "$ref": "#/$defs/short"
          }
        }
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "body",
          "linked",
          "pinned"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "body": {
            "enum": [
              "earth",
              "moon"
            ]
          },
          "linked": {
            "type": "boolean"
          },
          "pinned": {
            "type": "boolean"
          }
        }
      }
    },
    "counts": {
      "type": "object"
    },
    "linked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "body",
          "facts"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "body": {
            "enum": [
              "earth",
              "moon"
            ]
          },
          "facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/sourced"
            }
          }
        }
      }
    },
    "stories": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "steps"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "$ref": "#/$defs/short"
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entry",
                "text",
                "sources"
              ],
              "properties": {
                "entry": {
                  "$ref": "#/$defs/slug"
                },
                "text": {
                  "$ref": "#/$defs/short"
                },
                "sources": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/slug"
                  }
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/short"
          },
          "reason": {
            "$ref": "#/$defs/short"
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "short": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "date": {
      "type": "string",
      "pattern": "^-?[0-9]{1,4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "sourced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/short"
        },
        "source": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "everyday",
        "student"
      ],
      "properties": {
        "everyday": {
          "$ref": "#/$defs/text"
        },
        "student": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "status",
        "sources"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/short"
        },
        "status": {
          "enum": [
            "supported",
            "not-proven",
            "people-disagree"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/sourced"
          }
        }
      }
    }
  }
}
