{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/globedesk-bell-overview.schema.json",
  "title": "GlobeDesk bells overview record (globedesk.bell-overview/1)",
  "description": "The one overview record of the Bells layer (data/atlas/bells/bells-overview.json), written by tools/atlas/build-bells.mjs from tools/atlas/bells-overview.mjs. Sections cite source ids from atlas/packs/core/sources.json and link bell entry ids; counts are bells per region.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "checked", "license", "tiers", "sections", "counts", "eras"],
  "properties": {
    "schema": { "const": "globedesk.bell-overview/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "license": { "type": "string", "minLength": 1 },
    "tiers": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "text", "sources", "bells"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "bells": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "eras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "to"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "to": { "type": "integer" }
        }
      }
    }
  }
}
