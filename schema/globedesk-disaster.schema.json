{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/globedesk-disaster.schema.json",
  "title": "GlobeDesk disaster record (disasters layer)",
  "description": "One historic eruption or earthquake. Generated by tools/atlas/build-disasters.mjs from a curated NOAA NCEI subset and USGS pages. Every measure, fact and claim names a source id; gaps are [UNKNOWN]. The pin is NCEI's published point and is always approximate. No living people are subjects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "hazard",
    "region",
    "country",
    "place",
    "date",
    "ncei",
    "measures",
    "facts",
    "claims",
    "tiers",
    "sources",
    "official_sources",
    "official_status",
    "unknowns",
    "see_also_ids",
    "confidence",
    "checked",
    "license",
    "subject_person_living"
  ],
  "properties": {
    "schema": {
      "const": "globedesk.disaster/1"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "$ref": "#/$defs/short"
    },
    "hazard": {
      "enum": [
        "eruption",
        "earthquake"
      ]
    },
    "region": {
      "enum": [
        "Africa",
        "Asia",
        "Europe",
        "North America",
        "South America",
        "Oceania",
        "Antarctica"
      ]
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "lat",
        "lng",
        "approximate",
        "basis",
        "coords_source"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/short"
        },
        "lat": {
          "type": "number",
          "minimum": -90
        },
        "lng": {
          "type": "number",
          "minimum": -180
        },
        "approximate": {
          "const": true
        },
        "basis": {
          "$ref": "#/$defs/short"
        },
        "coords_source": {
          "$ref": "#/$defs/short"
        }
      }
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "precision",
        "label",
        "source"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "precision": {
          "enum": [
            "year",
            "month",
            "day"
          ]
        },
        "label": {
          "$ref": "#/$defs/short"
        },
        "source": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "ncei": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "event_id"
      ],
      "properties": {
        "dataset": {
          "enum": [
            "ncei-sig-volcanoes",
            "ncei-sig-earthquakes"
          ]
        },
        "event_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value",
          "source"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/short"
          },
          "value": {
            "$ref": "#/$defs/short"
          },
          "source": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourced"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "tiers": {
      "$ref": "#/$defs/tiers"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "official_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "official_status": {
      "enum": [
        "listed",
        "[UNKNOWN]"
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/short"
      }
    },
    "see_also_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "checked": {
      "$ref": "#/$defs/date"
    },
    "license": {
      "$ref": "#/$defs/short"
    },
    "subject_person_living": {
      "const": false
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "short": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "date": {
      "type": "string",
      "pattern": "^-?[0-9]{1,4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "sourced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/short"
        },
        "source": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "everyday",
        "student"
      ],
      "properties": {
        "everyday": {
          "$ref": "#/$defs/text"
        },
        "student": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "status",
        "sources"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/short"
        },
        "status": {
          "enum": [
            "supported",
            "not-proven",
            "people-disagree"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/sourced"
          }
        }
      }
    }
  }
}
