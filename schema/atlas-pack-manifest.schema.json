{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/atlas-pack-manifest.schema.json",
  "title": "GlobeDesk Atlas pack manifest (globedesk.atlas-pack/1) - DRAFT",
  "description": "One manifest per pack. sha256 is over the 'sha256  path' lines of the listed files, in order. Every pack stays under 50 MB. Promotion of a new pack version needs the owner's YES.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "kind", "version", "license", "checked", "sha256", "entry_count", "size_bytes", "max_bytes", "refresh", "promote", "files"],
  "properties": {
    "schema": { "const": "globedesk.atlas-pack/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "kind": { "enum": ["core", "category"] },
    "category": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[a-z0-9.]+)?$" },
    "license": { "type": "string", "pattern": "^CC BY 4\\.0" },
    "checked": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entry_count": { "type": "integer", "minimum": 0 },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "max_bytes": { "const": 52428800 },
    "refresh": { "enum": ["weekly", "quarterly", "with-release"] },
    "promote": { "const": "owner-yes-required" },
    "status": { "enum": ["draft", "promoted"] },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "if": { "properties": { "kind": { "const": "category" } } },
  "then": { "required": ["category"] }
}
