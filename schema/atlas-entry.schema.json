{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/atlas-entry.schema.json",
  "title": "GlobeDesk Atlas index entry (globedesk.atlas-entry/1) - DRAFT",
  "description": "One encyclopedia entry. GlobeDesk's own cited text only. No entry about a living person: subject_person_living must be false. Officials may be named only by public role inside an event entry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "kind", "category_path", "tier", "summary", "places", "dates", "sources", "related", "pack", "status", "confidence", "license", "checked", "current", "subject_person_living"],
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "title": { "$ref": "#/$defs/text" },
    "aliases": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "kind": { "enum": ["object", "topic", "chemistry", "place", "event", "record", "dataset"] },
    "category_path": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/slug" }, "description": "Home category and subcategory. Never 'now': Now is shown through the current tag." },
    "see_also_paths": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/slug" } } },
    "tier": { "enum": ["kids", "everyday", "student", "professional"] },
    "summary": { "$ref": "#/$defs/text" },
    "places": { "type": "array", "items": { "$ref": "#/$defs/place" } },
    "dates": { "type": "array", "items": { "$ref": "#/$defs/dated" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
    "related": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "pack": { "$ref": "#/$defs/slug" },
    "status": { "enum": ["placeholder", "draft", "reviewed", "built-and-tested"] },
    "confidence": { "enum": ["high", "medium", "low", "[UNKNOWN]"] },
    "license": { "type": "string", "pattern": "^CC BY 4\\.0" },
    "checked": { "$ref": "#/$defs/day" },
    "current": { "type": "boolean" },
    "now_until": { "$ref": "#/$defs/day" },
    "subject_person_living": { "const": false },
    "officials_in_role": { "type": "array", "items": { "$ref": "#/$defs/official" } },
    "record": { "type": "string", "pattern": "^data/atlas/[a-z]+/[A-Za-z0-9-]+\\.json$" },
    "records": { "type": "array", "items": { "type": "string", "pattern": "^data/atlas/[a-z]+/[A-Za-z0-9-]+\\.json$" } },
    "outbound": { "type": "array", "items": { "$ref": "#/$defs/outbound" } },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "placeholder" } } },
      "then": { "properties": { "title": { "pattern": "^\\[PLACEHOLDER\\] " } } },
      "else": { "properties": { "sources": { "minItems": 1 } } } },
    { "if": { "properties": { "current": { "const": true } } }, "then": { "required": ["now_until"] } },
    { "if": { "properties": { "kind": { "const": "event" } } }, "else": { "not": { "required": ["officials_in_role"] } } }
  ],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "place": {
      "type": "object", "additionalProperties": false, "required": ["precision"],
      "properties": {
        "region": { "type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$" },
        "lat": { "type": "number" }, "lng": { "type": "number" },
        "precision": { "enum": ["country", "subdivision", "city", "site"] },
        "note": { "type": "string", "maxLength": 300 }
      }
    },
    "dated": {
      "type": "object", "additionalProperties": false, "required": ["date", "precision", "approximate"],
      "description": "Astronomical years (1 BCE = 0, 2 BCE = -1). Form must match precision: year YYYY, month YYYY-MM, day YYYY-MM-DD.",
      "properties": {
        "date": { "type": "string", "pattern": "^-?[0-9]{1,4}(-[0-9]{2}(-[0-9]{2})?)?$" },
        "end": { "type": "string", "pattern": "^-?[0-9]{1,4}(-[0-9]{2}(-[0-9]{2})?)?$" },
        "precision": { "enum": ["year", "month", "day"] },
        "approximate": { "type": "boolean" },
        "label": { "type": "string", "maxLength": 200 }
      }
    },
    "link": {
      "type": "object", "additionalProperties": false, "required": ["type", "to"],
      "properties": {
        "type": { "enum": ["uses", "made-of", "priced-in", "cited-by", "located-at", "happened-in", "part-of", "see-also"] },
        "to": { "$ref": "#/$defs/slug" }
      }
    },
    "official": {
      "type": "object", "additionalProperties": false, "required": ["role"],
      "properties": { "role": { "$ref": "#/$defs/text" }, "name": { "type": "string", "maxLength": 120 }, "source": { "$ref": "#/$defs/slug" } }
    },
    "outbound": {
      "type": "object", "additionalProperties": false, "required": ["title", "url"],
      "properties": { "title": { "$ref": "#/$defs/text" }, "url": { "type": "string", "pattern": "^https://" }, "note": { "type": "string", "maxLength": 300 } }
    }
  }
}
