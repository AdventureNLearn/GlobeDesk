{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/globedesk-bell.schema.json",
  "title": "GlobeDesk bell record (Bells layer)",
  "description": "One bell, ring, carillon or chime set. Generated by tools/atlas/build-bells.mjs. Every fact names a source id; gaps are [UNKNOWN]. No living people are subjects. Coordinates are lookups of the named site (OpenStreetMap Nominatim, ODbL); approximate pins say so.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "kind",
    "status",
    "status_note",
    "era",
    "region",
    "country",
    "place",
    "maker",
    "mass_kg",
    "mass_note",
    "diameter_m",
    "height_m",
    "note",
    "alloy",
    "timeline",
    "tiers",
    "sources",
    "official_sources",
    "official_status",
    "model",
    "unknowns",
    "confidence",
    "checked",
    "license"
  ],
  "properties": {
    "schema": {
      "const": "globedesk.bell/1"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "$ref": "#/$defs/short"
    },
    "kind": {
      "enum": [
        "bell",
        "ring",
        "carillon",
        "chime-set",
        "ship-bell"
      ]
    },
    "status": {
      "enum": [
        "in-place",
        "museum",
        "lost",
        "in-storage",
        "[UNKNOWN]"
      ]
    },
    "status_note": {
      "$ref": "#/$defs/short"
    },
    "era": {
      "enum": [
        "ancient",
        "medieval",
        "early-modern",
        "19th-century",
        "20th-century",
        "21st-century",
        "[UNKNOWN]"
      ]
    },
    "region": {
      "enum": [
        "Africa",
        "Asia",
        "Europe",
        "North America",
        "South America",
        "Oceania"
      ]
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "lat",
        "lng",
        "approximate",
        "basis",
        "coords_source"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/short"
        },
        "lat": {
          "type": "number",
          "minimum": -90
        },
        "lng": {
          "type": "number",
          "minimum": -180
        },
        "approximate": {
          "type": "boolean"
        },
        "basis": {
          "enum": [
            "current",
            "building",
            "findspot",
            "last-known",
            "home-town"
          ]
        },
        "coords_source": {
          "const": "OpenStreetMap Nominatim lookup of the named site (ODbL)"
        }
      }
    },
    "maker": {
      "$ref": "#/$defs/short"
    },
    "mass_kg": {
      "$ref": "#/$defs/posOrNull"
    },
    "mass_note": {
      "$ref": "#/$defs/short"
    },
    "diameter_m": {
      "$ref": "#/$defs/posOrNull"
    },
    "height_m": {
      "$ref": "#/$defs/posOrNull"
    },
    "thickness_m": {
      "$ref": "#/$defs/posOrNull"
    },
    "note": {
      "if": {
        "type": "string"
      },
      "then": {
        "maxLength": 200
      },
      "else": {
        "const": null
      }
    },
    "bells_count": {
      "$ref": "#/$defs/countOrNull"
    },
    "alloy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "note"
      ],
      "properties": {
        "entry": {
          "const": "bell-bronze"
        },
        "note": {
          "$ref": "#/$defs/short"
        }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "precision",
          "approximate",
          "event",
          "source"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^-?[0-9]{1,4}(-[0-9]{2}(-[0-9]{2})?)?$"
          },
          "end": {
            "type": "string",
            "pattern": "^-?[0-9]{1,4}(-[0-9]{2}(-[0-9]{2})?)?$"
          },
          "precision": {
            "enum": [
              "year",
              "month",
              "day"
            ]
          },
          "approximate": {
            "type": "boolean"
          },
          "event": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "everyday",
        "student"
      ],
      "properties": {
        "everyday": {
          "$ref": "#/$defs/text"
        },
        "student": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "official_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "official_status": {
      "enum": [
        "listed",
        "[UNKNOWN]"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "available",
        "from_sources",
        "label"
      ],
      "properties": {
        "id": {
          "enum": [
            "bell",
            "none"
          ]
        },
        "available": {
          "type": "boolean"
        },
        "from_sources": {
          "type": "boolean",
          "description": "true when the diameter (and height or thickness if given) come from the cited sources"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "diameter_m": {
              "type": "number"
            },
            "height_m": {
              "type": "number"
            },
            "thickness_m": {
              "type": "number"
            }
          }
        },
        "label": {
          "$ref": "#/$defs/short"
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/short"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "checked": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "license": {
      "const": "CC BY 4.0 (our record text); linked sources keep their own terms"
    },
    "subject_person_living": {
      "const": false
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "short": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "posOrNull": {
      "description": "A positive number, or null when [UNKNOWN] (the *_note field says why).",
      "if": {
        "type": "number"
      },
      "then": {
        "minimum": 0
      },
      "else": {
        "const": null
      }
    },
    "countOrNull": {
      "if": {
        "type": "integer"
      },
      "then": {
        "minimum": 1
      },
      "else": {
        "const": null
      }
    }
  }
}
