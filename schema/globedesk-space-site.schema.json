{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://globedesk.local/schema/globedesk-space-site.schema.json",
  "title": "GlobeDesk space site record (space layer)",
  "description": "One launch site on Earth or one landing site on the Moon. Generated by tools/atlas/build-space.mjs from NASA NSSDCA, the IAU Gazetteer of Planetary Nomenclature and official agency pages. Every measure and fact names a source id; gaps are [UNKNOWN]. Earth pins are one approximate point; Moon sites carry lunar coordinates as published and no Earth pin. No living people are subjects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "body",
    "kind",
    "region",
    "country",
    "place",
    "dates",
    "measures",
    "facts",
    "claims",
    "tiers",
    "sources",
    "official_sources",
    "official_status",
    "unknowns",
    "see_also_ids",
    "confidence",
    "checked",
    "license",
    "subject_person_living"
  ],
  "properties": {
    "schema": {
      "const": "globedesk.space-site/1"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "$ref": "#/$defs/short"
    },
    "body": {
      "enum": [
        "earth",
        "moon"
      ]
    },
    "kind": {
      "enum": [
        "launch-site",
        "lunar-landing",
        "robotic-landing"
      ]
    },
    "region": {
      "enum": [
        "Africa",
        "Asia",
        "Europe",
        "North America",
        "South America",
        "Oceania",
        "Antarctica",
        "Moon"
      ]
    },
    "country": {
      "type": "string",
      "pattern": "^([A-Z]{2}|\\[UNKNOWN\\])$"
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "body",
        "lat",
        "lng",
        "approximate",
        "basis",
        "coords_source_id",
        "coords_text"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/short"
        },
        "body": {
          "enum": [
            "earth",
            "moon"
          ]
        },
        "lat": {
          "type": "number",
          "minimum": -90
        },
        "lng": {
          "type": "number",
          "minimum": -180
        },
        "approximate": {
          "type": "boolean"
        },
        "basis": {
          "$ref": "#/$defs/short"
        },
        "coords_source_id": {
          "$ref": "#/$defs/slug"
        },
        "coords_text": {
          "$ref": "#/$defs/short"
        }
      }
    },
    "dates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "precision",
          "label"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "precision": {
            "enum": [
              "year",
              "month",
              "day"
            ]
          },
          "label": {
            "$ref": "#/$defs/short"
          }
        }
      }
    },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value",
          "source"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/short"
          },
          "value": {
            "$ref": "#/$defs/short"
          },
          "source": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourced"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "tiers": {
      "$ref": "#/$defs/tiers"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "official_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "official_status": {
      "enum": [
        "listed",
        "[UNKNOWN]"
      ]
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/short"
      }
    },
    "see_also_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "checked": {
      "$ref": "#/$defs/date"
    },
    "license": {
      "$ref": "#/$defs/short"
    },
    "subject_person_living": {
      "const": false
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "short": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "date": {
      "type": "string",
      "pattern": "^-?[0-9]{1,4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "sourced": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/short"
        },
        "source": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "tiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "everyday",
        "student"
      ],
      "properties": {
        "everyday": {
          "$ref": "#/$defs/text"
        },
        "student": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "status",
        "sources"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/short"
        },
        "status": {
          "enum": [
            "supported",
            "not-proven",
            "people-disagree"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/sourced"
          }
        }
      }
    }
  }
}
